{
  "name": "lean4monaco-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "cd server && npm install",
    "build:client": "tsc -b && vite build",
    "build:server": "cd server && npm run build",
    "build": "concurrently \"npm run build:client\" \"npm run build:server\" -n client,server -c \"bgBlue.bold,bgMagenta.bold\"",
    "start:client": "vite --host",
    "start:server": "cd server && npm run build && npm run start",
    "start": "concurrently \"npm run start:client\" \"npm run start:server\" -n client,server -c \"bgBlue.bold,bgMagenta.bold\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "jotai": "^2.18.0",
    "lean4monaco": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^6.2.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-static-copy": "^2.3.0"
  }
}
